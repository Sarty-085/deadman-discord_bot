# Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Bot Prefix (default: h!)
BOT_PREFIX=h!

# Bot Owner User ID (optional, grants bypass on admin commands)
BOT_OWNER_ID=

# --- Lavalink Music Server Configuration ---
# If hosting on bot-hosting.net or private VPS:
LAVALINK_HOST=your-lavalink-host.bothosting.net
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# Or provide full URI directly (e.g. http://localhost:2333)
LAVALINK_URI=http://your-lavalink-host.bothosting.net:2333
